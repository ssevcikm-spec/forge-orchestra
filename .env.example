# Nastavení orchestra pro ovládání z příkazové řádky.
# Zkopíruj tento soubor jako .env a doplň hodnoty (soubor .env se necommituje).
#
# FORGE_URL   – adresa nasazeného conductora (vypíše ji `wrangler deploy`)
# FORGE_SECRET – stejné tajemství, jaké má conductor v Cloudflare (WEBHOOK_SECRET)
#
# Použití: node bin/task.mjs add "Nazev" "Zadani pro agenta"

FORGE_URL=https://forge-conductor.TVUJ-SUBDOMAIN.workers.dev
FORGE_SECRET=sem-vloz-stejne-tajemstvi-jako-do-cloudflare
